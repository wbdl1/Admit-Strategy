# Public build configuration only. No secret/service-role keys belong here.
APP_ENV=development
APP_BACKEND=legacy
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Enable only after real Google OAuth configuration and verification.
GOOGLE_AUTH_ENABLED=false

# Cloudflare Pages production build (only after the release checklist passes):
# APP_ENV=production
# APP_BACKEND=supabase
# SUPABASE_URL=https://jjdzogjuuitzhxmnoacw.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<the existing project's modern publishable key>
# GOOGLE_AUTH_ENABLED=true
# Disable Pages preview branch deployments. Never add SMTP/OAuth/service secrets here.
